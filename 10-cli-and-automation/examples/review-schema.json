{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "verification_gaps"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "location", "risk"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "location": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          }
        }
      }
    },
    "verification_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
